# Monorepo Environment Variables Baseline
NODE_ENV=development
PORT=3000

# Database & Redis
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/skincare_platform_dev?schema=public"
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_SECRET="super-secret-development-jwt-signing-key-32-chars"
JWT_EXPIRES_IN="1d"

# Service Ports
BACKEND_API_PORT=3000
RECOMMENDATION_ENGINE_PORT=8000
AI_WORKER_PORT=8001
STOREFRONT_WIDGET_PORT=5173
ADMIN_DASHBOARD_PORT=3001

# AI Worker Configuration
AI_PROVIDER=MOCK
AI_MODEL_NAME=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=dummy_key_for_development
