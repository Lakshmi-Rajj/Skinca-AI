# ─── Consumer Mobile App — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in values for your environment.
# .env is gitignored — never commit it.
#
# IMPORTANT: VITE_GEMINI_API_KEY has been REMOVED.
# The Gemini API key now lives server-side in apps/backend-api/.env (GEMINI_API_KEY).
# The client calls the backend proxy at /api/v1/skin/analyze — the key is never exposed.

# ── Backend API Base URL ──────────────────────────────────────────────────────
# Deployment matrix:
#
#   Local dev (browser):
#     Leave empty — Vite proxies /api/ → http://localhost:3001 automatically.
#     VITE_API_BASE_URL=
#
#   Production web deploy:
#     Set to your deployed backend URL.
#     VITE_API_BASE_URL=https://api.yourdomain.com
#
#   Capacitor APK (Android/iOS):
#     REQUIRED — relative URLs fail from the Capacitor native scheme.
#     Set this before running `npm run build` then sync/build the APK.
#     VITE_API_BASE_URL=https://api.yourdomain.com
#
VITE_API_BASE_URL=

# Future keys (client-safe only — never put secret keys here)
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_FIREBASE_API_KEY=
