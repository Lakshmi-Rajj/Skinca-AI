# ============================================================
# Backend API — Environment Variables
# Copy this file to .env and fill in real values.
# .env is gitignored and must NEVER be committed.
# ============================================================

NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────────────────
# Required. PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:password@localhost:5432/skincare_dev

# ── Auth ──────────────────────────────────────────────────────
# Required. Must be at least 16 characters.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# ── Redis (optional for dev) ──────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Gemini AI (server-side only — NEVER add VITE_ prefix) ────
# This key is held server-side. The client calls /api/v1/skin/analyze
# and never sees this value. Rotate immediately if accidentally committed.
GEMINI_API_KEY=

# ── CORS / Origin Allowlist (production hardening) ───────────
# Comma-separated list of allowed request origins for /api/v1/skin/analyze.
# Leave empty in development (all origins allowed).
# Example: ALLOWED_ORIGINS=https://app.yourdomain.com,https://yourdomain.com
ALLOWED_ORIGINS=

# ── Auth0 (optional, for social login) ───────────────────────
AUTH0_DOMAIN=
AUTH0_AUDIENCE=

# ── Widget JWT ────────────────────────────────────────────────
WIDGET_JWT_PUBLIC_KEY=
